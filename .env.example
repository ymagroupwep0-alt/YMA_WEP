# PostgreSQL connection string for local development or deployment.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/yma_wep?schema=public"

# Secret used to sign the HttpOnly session cookie. Use a long random value locally.
AUTH_SECRET="replace-with-a-long-random-secret"

# Required by prisma db seed. Do not commit real values.
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-local-password"
INITIAL_ADMIN_NAME="YMA Administrator"
